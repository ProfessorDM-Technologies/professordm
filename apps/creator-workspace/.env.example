# Copy to .env.local and fill in. Same Supabase project as apps/consumer.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-side endpoint for the staging POST /api/send Lambda.
INSTAGRAM_SEND_API_URL=
# Optional. Public origin for canonical links (e.g. https://professordm-creator-workspace.vercel.app).
# On Vercel the production domain is used automatically; locally it falls back to http://localhost:3001.
NEXT_PUBLIC_SITE_URL=
